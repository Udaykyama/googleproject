# Production: copy outside the checkout to /etc/inboxready/app.env, keep it
# mode 0640 root:inboxready-deploy, and use an approved GHCR digest.
# Local-only builds may set APP_IMAGE=inboxready:local when explicitly adding
# compose.local.yaml. Fill every blank required value.
APP_IMAGE=
APP_DATA_DIR=
BACKUP_DIR=
SECRET_KEY=

APP_PORT=8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
LIVE_DNS=0
LOG_FORMAT=json
LOG_LEVEL=INFO
LOG_CLIENT_ADDRESS=0
